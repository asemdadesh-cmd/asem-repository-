# Postgres connection string. On Supabase use the pooler in *session* mode (port 5432) —
# transaction mode (6543) stalls on pipelined parallel queries.
DATABASE_URL=postgres://user.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
# Password the shop owner types to log in.
APP_PASSWORD=change-me
# Random string (32+ chars) used to sign the login cookie. Generate: openssl rand -hex 32
SESSION_SECRET=
# Timezone used to show and enter dates.
APP_TIMEZONE=Europe/London
# Web Push (weekly reminder). Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.vercel.app
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Random string.
CRON_SECRET=
