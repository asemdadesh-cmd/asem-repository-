# ---- Supabase -------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Project Settings -> API -> service_role. SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Web Push (VAPID) -----------------------------------------------------
# Generate a pair with: npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Reminder scheduler ---------------------------------------------------
# Shared secret between Postgres (pg_cron) and /api/cron/reminders.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Public origin of the deployed app, used in notification deep links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
