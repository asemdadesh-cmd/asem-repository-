{
  "name": "villa-serena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Villa Serena — a realistic two-player 3D seaside world, modelled in SketchUp.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "models": "python3 sketchup/tools/build.py && node scripts/optimize-models.mjs",
    "shots": "node tests/shots.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "mqtt": "^5.16.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "aedes": "^1.2.0",
    "meshoptimizer": "^0.25.0",
    "playwright": "1.56",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
